[mlflow]
# NO_PERMISSIONS = private by default (verified: a non-owner gets 403 on
# direct access AND the experiment doesn't even appear in search results).
# READ would make every user's experiments visible to everyone else by
# default -- fine for a small trusted team, not the right default for a
# shared multi-user cluster. Owners can still selectively share via
# POST /api/3.0/mlflow/users/permissions/grant (see README).
default_permission = NO_PERMISSIONS
database_uri = sqlite:////home/apps/mlflow/basic_auth.db
admin_username = admin
admin_password = CHANGE_ME_BEFORE_DEPLOY
authorization_function = mlflow.server.auth:authenticate_request_basic_auth
grant_default_workspace_access = false
