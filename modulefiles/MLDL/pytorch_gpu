#%Module1.0
#
# MLDL :: PyTorch (GPU)
# Conda environment shipped under /home/apps/MLDL/DL-CondaPy3.10/envs/Pytorch-gpu
# CUDA: 11.8 (torch 2.2.1+cu118)
#

module-whatis "MLDL PyTorch (GPU) conda environment (Pytorch-gpu), CUDA: 11.8"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  PyTorch (GPU)"
    puts stderr "  CUDA   : 11.8 (torch 2.2.1+cu118)"
    puts stderr "  Prefix : /home/apps/MLDL/DL-CondaPy3.10/envs/Pytorch-gpu"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# Only one MLDL conda environment can be active at a time. Loading another
# member of this family auto-swaps the previous one out instead of silently
# stacking two envs' bin/ dirs onto PATH.
family "condaenv"

set condaroot /home/apps/MLDL/DL-CondaPy3.10
set envname   Pytorch-gpu
set envpath   $condaroot/envs/$envname

if { ![file isdirectory $envpath] } {
    puts stderr "MLDL/pytorch_gpu: $envpath does not exist"
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  $envname
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
