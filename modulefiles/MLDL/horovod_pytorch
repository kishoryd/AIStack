#%Module1.0
#
# MLDL :: Horovod + PyTorch (GPU)
# Conda environment shipped under /home/apps/MLDL/DL-CondaPy3.10/envs/Horovod-Pytorch
# CUDA: GPU-enabled build (run `conda list` in-env for exact CUDA runtime)
#

module-whatis "MLDL Horovod + PyTorch (GPU) conda environment (Horovod-Pytorch)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Horovod + PyTorch (GPU)"
    puts stderr "  CUDA   : GPU-enabled build (run \`conda list\` in-env for exact CUDA runtime)"
    puts stderr "  Prefix : /home/apps/MLDL/DL-CondaPy3.10/envs/Horovod-Pytorch"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# Only one MLDL conda environment can be active at a time. Loading another
# member of this family auto-swaps the previous one out instead of silently
# stacking two envs' bin/ dirs onto PATH.
family "condaenv"

set condaroot /home/apps/MLDL/DL-CondaPy3.10
set envname   Horovod-Pytorch
set envpath   $condaroot/envs/$envname

if { ![file isdirectory $envpath] } {
    puts stderr "MLDL/horovod_pytorch: $envpath does not exist"
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  $envname
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
