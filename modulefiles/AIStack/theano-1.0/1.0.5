#%Module1.0
#
# AIStack :: Theano 1.0.5
# Legacy
# CUDA: n/a (GPU via pygpu/libgpuarray, not CUDA-indexed)
#

module-whatis "AIStack Theano 1.0.5 :: Legacy, CUDA: n/a (GPU via pygpu/libgpuarray, not CUDA-indexed)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Theano 1.0.5"
    puts stderr "  Category : Legacy"
    puts stderr "  CUDA     : n/a (GPU via pygpu/libgpuarray, not CUDA-indexed)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/theano-1.0"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/theano-1.0

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/theano-1.0/1.0.5: $envpath does not exist -- run install_aistack.sh first."
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  theano-1.0
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
