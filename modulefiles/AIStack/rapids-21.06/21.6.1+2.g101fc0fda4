#%Module1.0
#
# AIStack :: Rapids 21.6.1+2.g101fc0fda4
# Legacy
# CUDA: 11.2 (cudatoolkit=11.2)
#

module-whatis "AIStack Rapids 21.6.1+2.g101fc0fda4 :: Legacy, CUDA: 11.2 (cudatoolkit=11.2)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Rapids 21.6.1+2.g101fc0fda4"
    puts stderr "  Category : Legacy"
    puts stderr "  CUDA     : 11.2 (cudatoolkit=11.2)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/rapids-21.06"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/rapids-21.06

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/rapids-21.06/21.6.1+2.g101fc0fda4: $envpath does not exist -- run install_aistack.sh first."
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  rapids-21.06
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
