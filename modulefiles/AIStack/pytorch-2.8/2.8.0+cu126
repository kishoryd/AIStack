#%Module1.0
#
# AIStack :: PyTorch 2.8.0+cu126
# Legacy
# CUDA: 12.6 (cu126 wheel index)
#

module-whatis "AIStack PyTorch 2.8.0+cu126 :: Legacy, CUDA: 12.6 (cu126 wheel index)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  PyTorch 2.8.0+cu126"
    puts stderr "  Category : Legacy"
    puts stderr "  CUDA     : 12.6 (cu126 wheel index)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/pytorch-2.8"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/pytorch-2.8

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/pytorch-2.8/2.8.0+cu126: $envpath does not exist"
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  pytorch-2.8
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
