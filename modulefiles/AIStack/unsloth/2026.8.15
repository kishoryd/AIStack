#%Module1.0
#
# AIStack :: Unsloth 2026.8.15
# Finetuning
# CUDA: 12.8 (cu128 wheel index)
#

module-whatis "AIStack Unsloth 2026.8.15 :: Finetuning, CUDA: 12.8 (cu128 wheel index)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Unsloth 2026.8.15"
    puts stderr "  Category : Finetuning"
    puts stderr "  CUDA     : 12.8 (cu128 wheel index)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/unsloth"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/unsloth

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/unsloth/2026.8.15: $envpath does not exist -- run install_aistack.sh first."
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  unsloth
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
