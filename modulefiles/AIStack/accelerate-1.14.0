#%Module1.0
#
# AIStack :: Accelerate 1.14.0
# Finetuning
# CUDA: 12.8 (cu128 wheel index)
#

module-whatis "AIStack Accelerate 1.14.0 :: Finetuning, CUDA: 12.8 (cu128 wheel index)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Accelerate 1.14.0"
    puts stderr "  Category : Finetuning"
    puts stderr "  CUDA     : 12.8 (cu128 wheel index)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/accelerate"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/accelerate

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/accelerate-1.14.0: $envpath does not exist -- run install_aistack.sh first."
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  accelerate
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
