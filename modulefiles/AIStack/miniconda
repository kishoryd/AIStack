#%Module1.0

## AIStack/miniconda - Miniconda base (no framework, just conda/python)
## Base conda install shipped at /home/apps/miniconda

set condaroot /home/apps/miniconda
set envname   base
set envpath   $condaroot

module-whatis "Miniconda base install (no framework, just conda/python) -- for building your own personal env"

proc ModulesHelp { } {
    global envname envpath
    puts stderr ""
    puts stderr "  Loads the base conda/python install (no framework env)."
    puts stderr "  CONDA_PREFIX -> $envpath"
    puts stderr ""
    puts stderr "  All the AIStack/* framework envs (unsloth, vllm, langchain, ...)"
    puts stderr "  are owned by cdacapp01 -- other users can load and use them but"
    puts stderr "  cannot pip/conda install into them. If you need a package that"
    puts stderr "  isn't already in one of those, build your own env off this base:"
    puts stderr ""
    puts stderr "    module load AIStack/miniconda"
    puts stderr "    conda create -n myenv python=3.11"
    puts stderr "    conda activate myenv"
    puts stderr ""
}

# Shares the same family as the MLDL modules -- they're conda envs in
# the same conda base, so loading one of these auto-swaps out any
# currently-loaded MLDL or AIStack env instead of stacking PATH entries.
family "condaenv"

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/miniconda: environment path $envpath does not exist -- run install_aistack.sh first."
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  $envname
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
