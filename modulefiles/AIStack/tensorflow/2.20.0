#%Module1.0
#
# AIStack :: TensorFlow GPU 2.20.0
# Legacy
# CUDA: bundled via tensorflow[and-cuda] pip extra
#

module-whatis "AIStack TensorFlow GPU 2.20.0 :: Legacy, CUDA: bundled via tensorflow[and-cuda] pip extra"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  TensorFlow GPU 2.20.0"
    puts stderr "  Category : Legacy"
    puts stderr "  CUDA     : bundled via tensorflow[and-cuda] pip extra"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/tensorflow-2.20"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/tensorflow-2.20

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/tensorflow/2.20.0: $envpath does not exist"
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  tensorflow-2.20
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
