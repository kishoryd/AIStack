#%Module1.0
#
# AIStack :: Caffe 1.0
# Legacy
# CUDA: n/a (GPU via caffe-gpu conda build)
#

module-whatis "AIStack Caffe 1.0 :: Legacy, CUDA: n/a (GPU via caffe-gpu conda build)"

proc ModulesHelp { } {
    puts stderr ""
    puts stderr "  Caffe 1.0"
    puts stderr "  Category : Legacy"
    puts stderr "  CUDA     : n/a (GPU via caffe-gpu conda build)"
    puts stderr "  Prefix   : /home/apps/miniconda/envs/caffe-1.0"
    puts stderr ""
    puts stderr "  This module does not change your shell prompt. To confirm it loaded:"
    puts stderr "    echo \$CONDA_DEFAULT_ENV"
    puts stderr "    which python"
    puts stderr ""
}

# One conda env active at a time: loading another MLDL/AIStack module
# swaps this one out instead of stacking PATH entries.
family "condaenv"

set envpath /home/apps/miniconda/envs/caffe-1.0

if { ![file isdirectory $envpath] } {
    puts stderr "AIStack/caffe/1.0: $envpath does not exist"
    break
}

setenv       CONDA_PREFIX       $envpath
setenv       CONDA_DEFAULT_ENV  caffe-1.0
setenv       CONDA_SHLVL        1
setenv       VIRTUAL_ENV        $envpath
prepend-path PATH               $envpath/bin
